    </a>
  </div>

  <div class="nav-menu">
    <nav>
      <ul class="nav-links">
        <li>
          <a href="/" class={`nav-link ${isHome ? 'active' : ''}`}>Home</a>
        </li>
        <li>
          <a href="/blog" class={`nav-link ${isBlog ? 'active' : ''}`}>Blog</a>
        </li>
      </ul>
    </nav>

    <div class="social-links">
      <a href="https://www.linkedin.com/in/alfredomartinez2245/" target="_blank" rel="noopener noreferrer" title="LinkedIn">
        <img src="/InBug-White.png" alt="LinkedIn" width="20" height="20" />
      </a>
      <a href="https://www.github.com/alfm2245/" target="_blank" rel="noopener noreferrer" title="GitHub">
        <img src="/GitHub_Invertocat_White.png" alt="GitHub" width="20" height="20" />
